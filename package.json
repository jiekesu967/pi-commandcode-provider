{
  "name": "pi-commandcode-provider",
  "version": "0.2.0",
  "private": true,
  "description": "Unofficial Command Code provider for pi, including the Go-plan CLI transport, browser login, and the Command Code web search / web fetch tools.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiekesu967/pi-commandcode-provider.git"
  },
  "homepage": "https://github.com/jiekesu967/pi-commandcode-provider#readme",
  "bugs": {
    "url": "https://github.com/jiekesu967/pi-commandcode-provider/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "commandcode",
    "command-code",
    "provider",
    "llm",
    "adapter"
  ],
  "pi": {
    "extensions": [
      "./index.ts",
      "./search.ts"
    ]
  },
  "scripts": {
    "test": "node tests/run-tests.mjs",
    "test:smoke": "node tests/run-tests.mjs smoke",
    "test:routing": "node tests/run-tests.mjs routing",
    "test:login": "node tests/run-tests.mjs login",
    "test:migration": "node tests/run-tests.mjs migration",
    "test:align": "node tests/run-tests.mjs align",
    "test:stream": "node tests/run-tests.mjs stream",
    "test:search": "node tests/run-tests.mjs search",
    "test:live": "node tests/run-tests.mjs live",
    "test:live-search": "node tests/run-tests.mjs live-search",
    "test:loop": "node tests/run-tests.mjs loop",
    "capabilities": "node scripts/extract-capabilities.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
